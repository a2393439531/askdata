# ===== 基础配置 =====
# JWT 密钥（生产环境务必修改）
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRE_HOURS=8

# SQLite 文件路径（相对于 backend/ 目录）
DB_PATH=data/hr_insight.db

# ===== 大模型（OpenAI 兼容接口），不填则问数走模板匹配降级 =====
# DeepSeek（https://platform.deepseek.com）
LLM_DEEPSEEK_API_KEY=
LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_DEEPSEEK_MODEL=deepseek-chat

# Qwen（阿里百炼，OpenAI 兼容模式 https://bailian.console.aliyun.com）
LLM_QWEN_API_KEY=
LLM_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_QWEN_MODEL=qwen-plus
